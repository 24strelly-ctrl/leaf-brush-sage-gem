{
  "build_artifacts": [
    ".next",
    "dist",
    "build",
    "target",
    "__pycache__",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    "*.pyc",
    "*.pyo",
    ".eggs",
    "*.egg-info",
    ".gradle",
    "out",
    ".idea",
    ".vscode",
    "tsconfig.tsbuildinfo",
    ".vercel/output"
  ],
  "temp_files": [
    "*.tmp",
    "*.temp",
    "*.swp",
    "*.swo",
    "*~",
    ".DS_Store",
    "Thumbs.db",
    ".DS_Store?",
    "._*",
    ".Spotlight-V100",
    ".Trashes",
    ".fseventsd"
  ],
  "log_files": [
    "*.log",
    "*.log.*",
    "logs/",
    "*.out",
    "*.err",
    "hs_err_pid*.log",
    "system.log",
    "crush.log"
  ],
  "duplicate_threshold_mb": 10,
  "max_age_days": 365,
  "protected_patterns": [
    ".git",
    ".env",
    "*.env",
    "credentials*",
    "*secret*",
    "*.key",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.cert",
    "cacert.pem",
    "roots.pem",
    "firebaseConfig.ts",
    "google-services.json",
    "GoogleService-Info.plist",
    ".vercel",
    "archives/",
    "migrations/",
    "public/",
    "src/",
    "server/",
    "scripts/",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
    "vercel.json",
    "AGENTS.md",
    "GO_LIVE_GUIDE.md",
    "DATABASE_SETUP.md",
    "node_modules"
  ],
  "archive_dir": "cleanup_archive",
  "dry_run": true,
  "verbose": true,
  "claude_model": "claude-3-5-sonnet-20241022",
  "use_intelligent_cleanup": false,
  "project_specific": {
    "excludes": [
      ".grok",
      "node_modules",
      "archives",
      "migrations",
      "public",
      "src",
      "server",
      "scripts"
    ],
    "aggressive_cleanup": []
  }
}
